{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ai-engineering-workflow/hermes-request.schema.json",
  "title": "Bounded Hermes delegation request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "delegation_reason",
    "scope",
    "project_context",
    "known_facts",
    "constraints",
    "prohibited_actions",
    "repository_modification_allowed",
    "network_reads_authorized",
    "external_writes_authorized",
    "expected_output",
    "state_references",
    "evidence_requirements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" },
    "objective": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "delegation_reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "scope": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "project_context": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
    "known_facts": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "constraints": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "prohibited_actions": { "type": "array", "minItems": 1, "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "repository_modification_allowed": { "const": false },
    "network_reads_authorized": { "const": true },
    "external_writes_authorized": { "const": false },
    "expected_output": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
    "state_references": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "evidence_requirements": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
  }
}
