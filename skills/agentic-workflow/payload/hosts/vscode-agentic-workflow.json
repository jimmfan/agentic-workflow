{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 .ai-workflow/runtime/controller.py hook --host vscode",
        "windows": "py -3 .ai-workflow\\runtime\\controller.py hook --host vscode",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python3 .ai-workflow/runtime/controller.py hook --host vscode",
        "windows": "py -3 .ai-workflow\\runtime\\controller.py hook --host vscode",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "python3 .ai-workflow/runtime/controller.py hook --host vscode",
        "windows": "py -3 .ai-workflow\\runtime\\controller.py hook --host vscode",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python3 .ai-workflow/runtime/controller.py hook --host vscode",
        "windows": "py -3 .ai-workflow\\runtime\\controller.py hook --host vscode",
        "cwd": ".",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .ai-workflow/runtime/controller.py hook --host vscode",
        "windows": "py -3 .ai-workflow\\runtime\\controller.py hook --host vscode",
        "cwd": ".",
        "timeout": 10
      }
    ]
  }
}
