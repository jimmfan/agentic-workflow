{
  "description": "Optional Agentic Workflow hooks; merge only after reviewing existing project hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai-workflow/runtime/controller.py hook --host codex",
            "commandWindows": "py -3 .ai-workflow\\runtime\\controller.py hook --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai-workflow/runtime/controller.py hook --host codex",
            "commandWindows": "py -3 .ai-workflow\\runtime\\controller.py hook --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai-workflow/runtime/controller.py hook --host codex",
            "commandWindows": "py -3 .ai-workflow\\runtime\\controller.py hook --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai-workflow/runtime/controller.py hook --host codex",
            "commandWindows": "py -3 .ai-workflow\\runtime\\controller.py hook --host codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .ai-workflow/runtime/controller.py hook --host codex",
            "commandWindows": "py -3 .ai-workflow\\runtime\\controller.py hook --host codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
